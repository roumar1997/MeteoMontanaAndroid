<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necesario para llamar a la API REST -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ubicación aproximada (para Tab Tiempo) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Notificaciones push (Android 13+ requiere permiso runtime) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AQUI NO VAN READ_MEDIA_IMAGES, READ_EXTERNAL_STORAGE NI ACCESS_MEDIA_LOCATION.
         La politica de Google Play ("Permisos de fotos y videos") solo admite el
         acceso amplio a la galeria si los selectores del sistema no bastan para
         la funcionalidad PRINCIPAL de la app; la nuestra es proponer piedras, y
         leer donde se hizo la foto es una comodidad. Con esos tres declarados,
         Play bloqueo el envio a revision de la vc91.
         La foto se elige con un selector del sistema. Ver PhotoPicker.kt. -->
    <application
        android:name=".MeteoMontanaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeteoMontana">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeteoMontana.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Links: enlaces compartidos https://.../s/... abren la app
                 directamente en la escuela o la vía (verificados via assetlinks.json). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="api.climbingteams.com" android:pathPrefix="/s/" />
                <data android:scheme="https" android:host="meteomontanaapi-staging.up.railway.app" android:pathPrefix="/s/" />
            </intent-filter>
        </activity>
        <!-- uCrop para recortar foto de perfil. Es NUESTRA subclase
             (CumbreCropActivity), no la de la librería: el tema
             `fitsSystemWindows` (2026-08-16) no bastó —con targetSdk 35+ el
             sistema ordena el borde a borde por código antes de mirar el
             tema— y el ✓ de aceptar seguía debajo del reloj en un Xiaomi
             real (Álvaro, 2026-08-25). CumbreCropActivity pide los márgenes
             por la API de insets, que sí se respeta. -->
        <activity
            android:name="com.meteomontana.android.ui.screens.profile.CumbreCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MeteoMontana.Crop" />

        <!-- Icono y color por defecto para pushes con bloque notification
             (los que pinta el sistema sin pasar por PushService) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_terra" />

        <!-- FileProvider: expone la imagen de "compartir condiciones" a otras apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Widget "Favoritas hoy" (Glance) -->
        <receiver
            android:name=".ui.widget.FavoritesWidgetReceiver"
            android:exported="true"
            android:label="Favoritas hoy">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_favorites_info" />
        </receiver>

        <!-- Servicio de Firebase Cloud Messaging â€” recibe pushes y muestra notificaciones -->
        <service
            android:name=".push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
