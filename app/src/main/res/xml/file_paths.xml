<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Imágenes temporales de "compartir condiciones" -->
    <cache-path name="share" path="share/" />
    <!-- Fotos de celebración del feed (cámara → TakePicture) -->
    <cache-path name="feed" path="feed/" />
    <!-- Foto tomada en el momento al proponer una piedra (cámara → TakePicture) -->
    <cache-path name="propuesta-piedra" path="propuesta-piedra/" />
    <!-- Foto tomada en el momento al EDITAR la foto de una cara ya existente
         (AddLinesFlow.kt, cámara → TakePicture) -->
    <cache-path name="editar-piedra" path="editar-piedra/" />
    <!-- Foto tomada en el momento al CREAR una piedra nueva, cualquiera de
         sus caras (BoulderFormDialog.kt, cámara → TakePicture) -->
    <cache-path name="nueva-piedra" path="nueva-piedra/" />
</paths>
